        {
          "type": "text",
          "text": "{\n  \"name\": \"Sinigang na Baboy (Pork Sinigang) for 4\",\n  \"ingredients\": [\n    {\"name\": \"Pork ribs or pork shoulder, bone-in\", \"amount\": \"1 kg (2.2 lb)\"},\n    {\"name\": \"Water\", \"amount\": \"8 cups (2 liters)\"},\n    {\"name\": \"Onion, quartered\", \"amount\": \"1 large\"},\n    {\"name\": \"Tomatoes, quartered\", \"amount\": \"2 medium\"},\n    {\"name\": \"Daikon radish (labanos), peeled and sliced\", \"amount\": \"1 cup\"},\n    {\"name\": \"Green beans (sitaw), cut into 2-inch pieces\", \"amount\": \"2 cups\"},\n    {\"name\": \"Tamarind paste or tamarind pulp\", \"amount\": \"1/2 cup tamarind paste (adjust to taste)\"},\n    {\"name\": \"Fish sauce (patis)\", \"amount\": \"2-3 tablespoons, to taste\"},\n    {\"name\": \"Leafy greens (kangkung, spinach, or bok choy)\", \"amount\": \"4 cups loosely packed\"}\n  ],\n  \"steps\": [\n    \"Rinse the pork and place in a large pot with 8 cups water. Bring to a boil, then lower heat to a simmer. Skim off any foam.\",\n    \"Add the onion and tomatoes. Simmer for about 45–60 minutes until the pork is tender.\",\n    \"Add the daikon and green beans. Simmer for another 10–15 minutes until the vegetables are just tender.\",\n    \"Stir in the tamarind paste. Simmer for 2–3 minutes, then taste and adjust sourness by adding more tamarind paste if needed.\",\n    \"Season with fish sauce. Add salt if desired and adjust to taste.\",\n    \"Add the leafy greens and simmer 1–2 minutes until wilted.\",\n    \"Serve hot with steamed rice.\"\n  ]\n}",
          "providerMetadata": {
            "openai": {
              "itemId": "msg_093cc577202e6a42006a930d2db2e487d08f5be288e60736dd"
            }
          }
        }
