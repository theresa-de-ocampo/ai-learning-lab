{
  "name": "film-fusion",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "concurrently --kill-others --names server,web \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --watch --env-file=.env server.ts",
    "dev:web": "vite",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.server.json",
    "build": "npm run typecheck && vite build",
    "serve": "node --env-file=.env server.ts"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "concurrently": "^10.0.5",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "express": "^5.2.1",
    "openai": "^7.10.0"
  }
}
